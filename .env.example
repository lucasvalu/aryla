# Copy to .env.

OLLAMA_BASE_URL=http://localhost:11434

# Absolute path the coding agent may read (served by the filesystem MCP server via npx).
# Without it the coding agent is disabled.
CODING_WORKSPACE=/absolute/path/to/your/repo

# Assistant behavior
APP_CONFIDENCE_THRESHOLD=0.6
APP_MAX_RECENT_MESSAGES=10
APP_KEEP_LAST_MESSAGES=4
APP_MAX_TOOL_ITERATIONS=6
APP_CHECKPOINT_DB=.data/checkpoints.sqlite

# Langfuse (optional, requires `uv sync --extra tracing`)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000
